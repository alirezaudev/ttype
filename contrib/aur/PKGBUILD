pkgname=ttype-bin
pkgver=0.0.0
pkgrel=1
pkgdesc="Terminal-first typing practice"
arch=('x86_64' 'aarch64')
url="https://github.com/alirezaudev/ttype"
license=('custom')
provides=('ttype')
conflicts=('ttype')

source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/ttype_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/ttype_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
	install -Dm755 "$srcdir/ttype" "$pkgdir/usr/bin/ttype"
	install -Dm644 "$srcdir/ttype.1" "$pkgdir/usr/share/man/man1/ttype.1"
}
